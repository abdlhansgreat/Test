# PhotoLancer environment variables — copy to .env and fill in.
# NEVER commit the real .env (it is gitignored).

# --- Supabase (frontend, safe to expose: anon key is RLS-protected) ---
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"
VITE_SUPABASE_PROJECT_ID="your-project-id"

# --- Supabase (server-side / SSR) ---
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"
SUPABASE_PROJECT_ID="your-project-id"

# ============================================================
# The values below are SECRETS. They belong in Supabase Edge
# Function secrets (supabase secrets set ...), NOT in this file
# and NOT in the frontend. Listed here only for reference.
# ============================================================

# SUPABASE_SERVICE_ROLE_KEY=   # full DB access — server only, never ship to client
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RESEND_API_KEY=
# PEXELS_API_KEY=
# UNSPLASH_ACCESS_KEY=
# APP_URL=https://your-domain.com
